# Copy this file to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Your real domain — used for metadata (canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=https://agencyfluxly.com

# ---------------------------------------------------------------------------
# Email delivery for the Contact + Booking forms  (Resend — https://resend.com)
# Free tier: 3,000 emails/month. Create a key at resend.com → API Keys.
# Without this key the forms still "succeed" for the visitor, but NO email is
# sent — so set it before launch or you will lose every lead.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Where form submissions are emailed (inbox that receives leads).
CONTACT_EMAIL=abdelwahabalbarkan2018@gmail.com

# From address. Until you verify your own domain in Resend, keep the default
# (Resend's shared onboarding sender). After verifying agencyfluxly.com in
# Resend, change to e.g. "Fluxly Agency <hello@agencyfluxly.com>".
CONTACT_FROM=Fluxly Agency <onboarding@resend.dev>
